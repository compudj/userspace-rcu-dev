if [ "x${URCU_TESTS_SRCDIR:-}" != "x" ]; then
	UTILSSH="$URCU_TESTS_SRCDIR/utils/utils.sh"
else
	UTILSSH="$(dirname "$0")/../utils/utils.sh"
fi

# shellcheck source=../utils/utils.sh
source "$UTILSSH"

# test_urcu_ft_inv emits TAP itself: one test per concurrent
# reader/writer invariant.
exec "${URCU_TESTS_BUILDDIR}/regression/test_urcu_ft_inv"
